{
  "name": "howmany-action",
  "version": "2.1.0",
  "description": "GitHub Action for HowMany code analysis tool",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "package": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "test": "node test/test-local.cjs",
    "test-full": "node test/test-local.cjs && node test/test-integration.cjs && node test/test-comprehensive.cjs",
    "dev": "tsc && node lib/index.js",
    "lint": "eslint src",
    "format": "prettier --write src/**/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GriffinCanCode/howmany-action.git"
  },
  "keywords": [
    "github-action",
    "code-analysis",
    "quality-metrics",
    "complexity",
    "maintainability",
    "documentation",
    "howmany"
  ],
  "author": "HowMany Team",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vercel/ncc": "^0.44.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=24"
  }
}
