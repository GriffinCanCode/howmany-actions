{
  "name": "howmany-action",
  "version": "2.1.0",
  "description": "GitHub Action for HowMany code analysis tool",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "package": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "test": "node test/test-local.js",
    "test-full": "node test/test-local.js && node test/test-integration.js && node test/test-comprehensive.js",
    "dev": "ts-node src/main.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GriffinCanCode/howmany-action.git"
  },
  "keywords": [
    "github-action",
    "code-analysis",
    "quality-metrics",
    "complexity",
    "maintainability",
    "documentation",
    "howmany"
  ],
  "author": "HowMany Team",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.0",
    "@actions/glob": "^0.4.0",
    "@actions/io": "^1.1.3",
    "@actions/tool-cache": "^2.0.1",
    "@octokit/rest": "^20.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=20"
  }
} 